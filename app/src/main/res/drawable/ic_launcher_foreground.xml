<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The uploaded artwork already carries its own black safe-zone padding. Render the
         complete square in the adaptive 108dp viewport so launcher masks crop only the canvas,
         never the 3x3 Mosaic mark. -->
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center"
        android:drawable="@drawable/mosaic_launcher_art" />
</layer-list>
